{
  "name": "@mayrlabs/web-icon",
  "version": "0.3.0",
  "description": "A web icon package for React and Vue",
  "keywords": [
    "icon",
    "react",
    "vue",
    "web-icon"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/MayR-Labs/mayrlabs-js/tree/main/packages/web-icon#readme",
  "bugs": {
    "url": "https://github.com/MayR-Labs/mayrlabs-js/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aghogho Meyoron",
    "email": "youngmayor.dev@gmail.com",
    "url": "https://mayrlabs.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MayR-Labs/mayrlabs-js.git",
    "directory": "packages/web-icon"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    },
    "./next": {
      "import": "./dist/next/index.mjs",
      "require": "./dist/next/index.cjs"
    },
    "./react": {
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs"
    },
    "./vue": {
      "import": "./dist/vue/index.mjs",
      "require": "./dist/vue/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "pkg:dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "demo": "tsx src/index.ts",
    "demo:dist": "node dist/index.js",
    "lint": "biome lint .",
    "format": "biome format ."
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.2",
    "@vitest/coverage-v8": "^4.0.18",
    "react": "^19.2.4",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue": "^3.5.28",
    "next": "^15.1.0"
  },
  "peerDependencies": {
    "next": "^13.0.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0 || ^20.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
