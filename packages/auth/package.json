{
  "name": "@mayrlabs/auth",
  "version": "0.5.1",
  "description": "A strictly typed, universal JWT and M2M authentication core library powering the MayR Labs ecosystem.",
  "keywords": [
    "auth",
    "authentication",
    "sso",
    "mayrlabs",
    "jwt",
    "encryption"
  ],
  "homepage": "https://github.com/MayR-Labs/mayrlabs-js/tree/main/packages/auth#readme",
  "bugs": {
    "url": "https://github.com/MayR-Labs/mayrlabs-js/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Aghogho Meyoron",
    "email": "youngmayor.dev@gmail.com",
    "url": "https://mayrlabs.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MayR-Labs/mayrlabs-js.git",
    "directory": "packages/auth"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "pkg:dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "demo": "tsx src/index.ts",
    "demo:dist": "node dist/index.js",
    "lint": "biome lint .",
    "format": "biome format .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "tsdown": "^0.21.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
